# Angular specific
/dist/
/out-tsc/
/tmp/
/coverage/
/e2e/test-output/
/.angular/
.angular/

# Node modules (árvore de dependências; nunca versionada)
/node_modules/
# NOTA (T-M0-4): package-lock.json É versionado — `npm ci` (CA-3 da SPEC-M0) exige o lockfile no repo.
/yarn.lock

# Environment files
/.env

# Angular CLI and build artefacts
/.angular-cli.json
/.ng/

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / editores (complemento T-M0-4)
.idea/
*.iml
.project
.classpath
.settings/
.history/
# VS Code: ignora estado do usuário, mantém as configs recomendadas geradas pelo Angular
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Cache do Angular CLI
/.angular/cache
.sass-cache/

# Arquivos de sistema operacional
.DS_Store
Thumbs.db
